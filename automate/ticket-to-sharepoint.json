{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "received_at": { "type": "string" },
            "name": { "type": "string" },
            "email": { "type": "string" },
            "category": { "type": "string" },
            "description": { "type": "string" },
            "file_note": { "type": "string" }
          },
          "required": ["name", "email", "category", "description"]
        }
      }
    }
  },
  "actions": {
    "Create_SharePoint_item": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_sharepointonline",
          "operationId": "PostItem"
        },
        "parameters": {
          "dataset": "https://contoso.sharepoint.com/sites/novatrix",
          "table": "Tickets",
          "item/Title": "@{triggerBody()?['name']}",
          "item/Email": "@{triggerBody()?['email']}",
          "item/Category": "@{triggerBody()?['category']}",
          "item/Description": "@{triggerBody()?['description']}",
          "item/FileNote": "@{triggerBody()?['file_note']}"
        }
      },
      "runAfter": {}
    },
    "Check_category": {
      "type": "If",
      "expression": "@equals(triggerBody()?['category'], 'critical')",
      "actions": {
        "Post_to_Teams": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_teams",
              "operationId": "PostMessageToConversation"
            },
            "parameters": {
              "poster": "User",
              "location": "Channel",
              "body/recipient": {
                "groupId": "REPLACE_WITH_TEAM_ID",
                "channelId": "REPLACE_WITH_CHANNEL_ID"
              },
              "body/messageBody": "<p>Ny kritisk supportförfrågan från @{triggerBody()?['name']}: @{triggerBody()?['description']}</p>"
            }
          },
          "runAfter": {}
        }
      },
      "else": {
        "actions": {
          "Send_Outlook_mail": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_office365",
                "operationId": "SendEmailV2"
              },
              "parameters": {
                "emailMessage/To": "@{triggerBody()?['email']}",
                "emailMessage/Subject": "Novatrix supportärende mottaget",
                "emailMessage/Body": "<p>Hej @{triggerBody()?['name']},</p><p>Ditt ärende (kategori: @{triggerBody()?['category']}) har mottagits.</p><p>Beskrivning: @{triggerBody()?['description']}</p><p>Med vänliga hälsningar,<br/>Novatrix support</p>"
              }
            },
            "runAfter": {}
          }
        }
      },
      "runAfter": {
        "Create_SharePoint_item": ["Succeeded"]
      }
    }
  }
}
